# Port the backend API listens on
PORT=5000

# Extra allowed browser origins (comma separated).
# http://localhost:<any port> is always allowed for local development.
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. setup.bat replaces this with a random value.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Upload limits and AI timeout
MAX_UPLOAD_MB=100
AI_TIMEOUT_SECONDS=300

# Leave empty to auto-use ai\venv\Scripts\python.exe
PYTHON_PATH=

# Paths are relative to the backend folder
DATABASE_PATH=../storage/assessments.db
UPLOAD_DIR=../storage/uploads


GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
COACH_TIMEOUT_SECONDS=45